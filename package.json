    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
